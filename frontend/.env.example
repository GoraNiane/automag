# AutoElite Environment Variables Example

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Image Storage Configuration (Optional, for production uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# WhatsApp seller configuration (international format, no spaces/characters, e.g., 221XXXXXXXXX)
VITE_WHATSAPP_SELLER_NUMBER=221781662009

# Social Media configuration URLs
VITE_TIKTOK_URL=https://www.tiktok.com/@autoelite
VITE_TWITTER_URL=https://twitter.com/autoelite
VITE_INSTAGRAM_URL=https://www.instagram.com/autoelite
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile


